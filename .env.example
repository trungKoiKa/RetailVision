# Mẫu biến môi trường. Sao chép thành .env (đã bị .gitignore) và điền giá trị thật.
# Mọi giá trị dưới đây là giả, KHÔNG dùng cho môi trường thật.

# MQTT (Pi edge và Spring backend)
RV_MQTT_HOST=127.0.0.1
RV_MQTT_PORT=1883
RV_MQTT_USER=edge01
RV_MQTT_PASS=change-me-edge01
RV_MQTT_BACKEND_USER=backend01
RV_MQTT_BACKEND_PASS=change-me-backend01
RV_MQTT_NODE_PASS=change-me-node01  # chỉ dùng cho deploy/pi/scripts/check_acl.py

# PostgreSQL (máy chủ LAN)
POSTGRES_DB=retailvision
POSTGRES_USER=retailvision
POSTGRES_PASSWORD=change-me-postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/retailvision
SPRING_DATASOURCE_USERNAME=retailvision
SPRING_DATASOURCE_PASSWORD=change-me-postgres

# Tài khoản web ban đầu (tạo khi bảng app_user rỗng, giai đoạn 10)
RV_ADMIN_USER=admin
RV_ADMIN_PASS=change-me-admin

# Múi giờ hiển thị và tổng hợp báo cáo
RV_TIMEZONE=Asia/Ho_Chi_Minh
