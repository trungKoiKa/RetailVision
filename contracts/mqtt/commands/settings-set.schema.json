{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retailvision.local/contracts/mqtt/commands/settings-set.schema.json",
  "title": "edge01/settings/set — Spring gửi tới Pi (P1)",
  "allOf": [
    {
      "$ref": "../common/envelope.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "request_id",
    "expected_settings_revision",
    "dwell_seconds",
    "on_count",
    "on_hold_seconds",
    "off_count",
    "off_hold_seconds"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_settings_revision": {
      "type": "integer",
      "minimum": 0
    },
    "dwell_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 60
    },
    "on_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "on_hold_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 3600
    },
    "off_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "off_hold_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 3600
    }
  },
  "unevaluatedProperties": false
}
