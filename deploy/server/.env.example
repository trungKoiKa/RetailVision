# Sao chép thành deploy/server/.env (đã bị .gitignore) và đổi mọi giá trị. KHÔNG commit bản thật.
# Các giá trị dưới đây là giả, dùng được cho demo trên máy cá nhân.

# PostgreSQL (nội bộ mạng Compose, không mở cổng)
POSTGRES_PASSWORD=change-me-postgres

# Broker MQTT. Vận hành thật: IP của Pi. Chạy demo (compose.demo.yaml): để nguyên "mosquitto".
RV_MQTT_HOST=mosquitto
RV_MQTT_PORT=1883
RV_MQTT_BACKEND_USER=backend01
RV_MQTT_BACKEND_PASS=

# Tài khoản ADMIN đầu tiên (chỉ tạo khi bảng tài khoản còn rỗng); đổi mật khẩu ngay sau khi đăng nhập
RV_ADMIN_USER=admin
RV_ADMIN_PASS=change-me-admin

# Cổng web trên máy chủ
WEB_PORT=8088
